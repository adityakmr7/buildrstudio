# BuildrStudio environment variables.
# Copy to .env.local for local dev (gitignored). Every integration is
# optional at build time and fails only where it's used (see CLAUDE.md).

# ── Database (Neon Postgres, via @prisma/adapter-neon) ──────────────────
DATABASE_URL=

# ── Auth (NextAuth v5, Google OAuth only) ───────────────────────────────
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local-only sign-in bypass. Hard-disabled when NODE_ENV=production.
DEV_BYPASS_AUTH=false
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# ── AI ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Billing: Paddle (merchant of record) ────────────────────────────────
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Free-trial limits are code constants (app/lib/trial.ts), not env vars.

# ── Lead notifications (optional) ───────────────────────────────────────
# With both set, each new lead is emailed to the agent owner's account email
# (per-install toggle in the dashboard). Without them, email is skipped and
# leads still appear on /dashboard/leads and go to the owner's webhook.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "BuildrStudio <leads@buildrstudio.in>"
LEADS_FROM_EMAIL=

# ── Razorpay (optional, INR / UPI payments for India) ────────────────────
# The whole Razorpay path stays off (Paddle only) unless all three are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# One Razorpay plan id per agent tier: RAZORPAY_PLAN_<AGENT_SLUG>_<TIER>, with the
# slug upper-cased and dashes turned into underscores. INR prices are read from
# the plan itself; there are no INR amounts in the code. A tier without a plan
# id just doesn't offer INR.
RAZORPAY_PLAN_SUPPORT_AGENT_STARTER_STANDARD=
RAZORPAY_PLAN_SUPPORT_AGENT_STARTER_PRO=
RAZORPAY_PLAN_RAG_KNOWLEDGE_ASSISTANT_STANDARD=
RAZORPAY_PLAN_RAG_KNOWLEDGE_ASSISTANT_PRO=
# Optional: billing cycles per subscription (Razorpay needs a finite count). Default 60.
# RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=60
