# BuildrStudio environment variables.
# Copy to .env.local for local dev (gitignored). Every integration is
# optional at build time and fails only where it's used (see CLAUDE.md).

# ── Database (Neon Postgres, via @prisma/adapter-neon) ──────────────────
DATABASE_URL=

# ── Auth (NextAuth v5, Google OAuth only) ───────────────────────────────
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local-only sign-in bypass. Hard-disabled when NODE_ENV=production.
DEV_BYPASS_AUTH=false
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# ── AI ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Billing: Paddle (merchant of record) ────────────────────────────────
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Free-trial limits are code constants (app/lib/trial.ts), not env vars.
