// Buildr Studio — Agent Marketplace data model
// See docs/buildr-studio-agent-storefront-plan.md (Section 10, decisions log)
// for why this looks the way it does:
//   - Runs against the existing Neon Postgres instance (DATABASE_URL), not a
//     new Supabase project — Neon is plain Postgres, Prisma just points at it.
//   - Billing fields are Paddle-shaped (paddleCustomerId / paddleSubscriptionId),
//     not Stripe.
//   - `Agent` is a fixed catalog entry (4 products, matching the slugs in
//     app/lib/agentCatalog.ts), not a user-created/owned resource — there is
//     no open marketplace where anyone can list an agent.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL is no longer set here — it's passed to
  // PrismaClient via a driver adapter at runtime (see app/lib/db.ts) and to
  // the CLI via prisma.config.ts (for `migrate`/`db push`/`studio`).
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys       ApiKey[]
  subscriptions AgentSubscription[]
  usage         Usage[]
  trials        Trial[]
  leads         Lead[]
}

/// One row per catalog product (see app/lib/agentCatalog.ts). Not user-owned —
/// this is our fixed marketplace, not an open one where anyone lists an agent.
model Agent {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  category     String
  systemPrompt String   @db.Text
  model        String   @default("gemini-2.5-flash")
  maxTokens    Int      @default(500)
  temperature  Float    @default(0.7)
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tiers         AgentTier[]
  apiKeys       ApiKey[]
  subscriptions AgentSubscription[]
  chatSessions  ChatSession[]
  messages      Message[]
  usage         Usage[]
  trials        Trial[]
  leads         Lead[]
}

/// Standard / Pro packaging per agent. `paddlePriceId` is null until real
/// pricing exists in the Paddle dashboard (plan Section 9, open decision #2)
/// — checkout refuses to open for a tier with no price attached rather than
/// guessing a dollar figure.
model AgentTier {
  id            String  @id @default(cuid())
  agentId       String
  agent         Agent   @relation(fields: [agentId], references: [id])
  name          String // "standard" | "pro"
  monthlyLimit  Int     @default(500)
  paddlePriceId String?

  subscriptions AgentSubscription[]

  @@unique([agentId, name])
}

/// The credential the embedded widget authenticates with. Also carries the
/// widget's per-install customization (greeting/color/position) shown in the
/// dashboard's "Edit config" modal, rather than a separate config table.
model ApiKey {
  id         String    @id @default(cuid())
  key        String    @unique
  name       String    @default("Default")
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  agentId    String
  agent      Agent     @relation(fields: [agentId], references: [id])
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  greeting String @default("Hi! How can I help you today?")
  color    String @default("#2563EB")
  position String @default("bottom-right") // "bottom-right" | "bottom-left"

  // Lead handoff (see app/lib/leads.ts). All optional — with none set, leads
  // still land in the dashboard (and by email if RESEND_API_KEY is set).
  leadEmailEnabled  Boolean @default(true)
  leadWebhookUrl    String?
  leadWebhookSecret String? // HMAC-SHA256 signing secret for leadWebhookUrl
  whatsappNumber    String? // digits incl. country code, e.g. 919876543210

  chatSessions     ChatSession[]
  documentChunks   DocumentChunk[]
  knowledgeSources KnowledgeSource[]
  leads            Lead[]
  unanswered       UnansweredQuestion[]
  trial            Trial?

  @@index([userId, agentId])
}

/// A no-card free trial of one live agent (see app/lib/trial.ts for the
/// limits and app/lib/trialServer.ts for issuance). One row per user per
/// agent, ever — the unique constraint is the "one trial per agent" rule.
/// The trial's ApiKey is the same key a paid subscription later keeps using
/// (the Paddle webhook reuses an existing key for user+agent), so upgrading
/// never breaks an embed that's already live. `convertedAt` is set when a
/// paid subscription activates; after that the subscription's tier limits
/// apply and the trial limits are ignored.
model Trial {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  agentId      String
  agent        Agent     @relation(fields: [agentId], references: [id])
  apiKeyId     String    @unique
  apiKey       ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  messageLimit Int
  messagesUsed Int       @default(0)
  startedAt    DateTime  @default(now())
  endsAt       DateTime
  convertedAt  DateTime?

  @@unique([userId, agentId])
  @@index([userId])
}

/// One customer's knowledge base, scoped to their ApiKey (one install = one
/// knowledge base — not a multi-document CMS). Embeddings are plain
/// `Float[]`, not pgvector: at indie/small-business scale (a few hundred
/// chunks per customer, not millions), computing cosine similarity in
/// application code is simpler than managing a Postgres extension and is
/// nowhere near a performance concern at this scale. See
/// app/lib/knowledge.ts for the retrieval logic.
model DocumentChunk {
  id        String           @id @default(cuid())
  apiKeyId  String
  apiKey    ApiKey           @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  source    String // filename, "Pasted text", or the page URL for crawled chunks
  content   String           @db.Text
  embedding Float[]
  createdAt DateTime         @default(now())
  // null = the pasted/uploaded text knowledge base (replaced as a whole on
  // save, as before). Set = chunks owned by one KnowledgeSource (a crawled
  // website), replaced only when that source is re-synced.
  sourceId  String?
  sourceRef KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([sourceId])
}

/// A knowledge source that isn't the pasted-text box — currently a website
/// crawled from a start URL or sitemap.xml (see app/lib/crawler.ts). Stores
/// the last sync's result so the dashboard can show pages found/ingested and
/// errors, and so "Re-sync" can re-crawl and replace just this source's chunks.
model KnowledgeSource {
  id            String    @id @default(cuid())
  apiKeyId      String
  apiKey        ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  kind          String    @default("website") // "website" | "qa" (answers added from Unanswered questions)
  url           String
  status        String    @default("pending") // pending | ok | partial | failed
  pagesFound    Int       @default(0)
  pagesIngested Int       @default(0)
  chunkCount    Int       @default(0)
  errors        Json? // [{ url, error }] from the last sync, capped
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  chunks DocumentChunk[]

  @@unique([apiKeyId, url])
  @@index([apiKeyId])
}

/// A conversation the widget is holding with one site visitor. Deliberately
/// separate from next-auth's own session concept (there isn't one in this
/// codebase — auth uses JWT sessions, no Prisma adapter, no DB-backed auth
/// session table).
model ChatSession {
  id            String               @id @default(cuid())
  agentId       String
  agent         Agent                @relation(fields: [agentId], references: [id])
  apiKeyId      String
  apiKey        ApiKey               @relation(fields: [apiKeyId], references: [id])
  messages      Message[]
  leads         Lead[]
  unanswered    UnansweredQuestion[]
  // Conversation-log bookkeeping (dashboard → Conversations). pageUrl is the
  // page the widget was opened on when the conversation started.
  pageUrl       String?
  messageCount  Int                  @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([apiKeyId, lastMessageAt])
}

model Message {
  id            String      @id @default(cuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id])
  agentId       String
  agent         Agent       @relation(fields: [agentId], references: [id])
  role          String // "user" | "assistant"
  content       String      @db.Text
  tokens        Int?
  createdAt     DateTime    @default(now())

  @@index([chatSessionId])
}

model Usage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id])
  month        String // "2026-08"
  messageCount Int      @default(0)
  tokenCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, agentId, month])
}

model AgentSubscription {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id])
  agentId                String
  agent                  Agent     @relation(fields: [agentId], references: [id])
  tierId                 String
  tier                   AgentTier @relation(fields: [tierId], references: [id])
  // "paddle" (default, all pre-existing rows) or "razorpay" (INR / UPI path)
  provider               String    @default("paddle")
  paddleCustomerId       String?
  paddleSubscriptionId   String?   @unique
  razorpaySubscriptionId String?   @unique
  razorpayCustomerId     String?
  // Razorpay only: owner asked to cancel; access continues until currentPeriodEnd.
  cancelAtPeriodEnd      Boolean   @default(false)
  // active | canceled | past_due | paused, plus "created" for a Razorpay
  // subscription whose checkout hasn't completed yet (never grants access).
  status                 String    @default("active")
  currentPeriodEnd       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId, agentId])
}

/// Webhook deliveries already handled, keyed by provider + the provider's
/// event id (Razorpay: x-razorpay-event-id). Makes retried/duplicated
/// deliveries a no-op.
model ProcessedWebhookEvent {
  id        String   @id // "<provider>:<event id>"
  provider  String
  eventType String
  createdAt DateTime @default(now())
}

/// A visitor who left their details in the widget's lead form — either
/// because the agent couldn't answer / they asked for a person (the chat API
/// returns a `handoff` signal) or via the widget's "Talk to a person" link.
/// Owned by the install (ApiKey) and its owner (User); linked to the
/// conversation it came from when there is one.
model Lead {
  id            String       @id @default(cuid())
  apiKeyId      String
  apiKey        ApiKey       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  agentId       String
  agent         Agent        @relation(fields: [agentId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  chatSessionId String?
  chatSession   ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  name          String
  email         String
  phone         String?
  message       String?      @db.Text
  trigger       String // "no_answer" | "asked_human" | "manual"
  pageUrl       String?
  emailStatus   String? // "sent" | "skipped" | "failed"
  webhookStatus String? // "sent" | "skipped" | "failed"
  createdAt     DateTime     @default(now())

  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
}

/// A visitor question the agent couldn't answer well — the model flagged it
/// ([[HANDOFF]]) or retrieval found nothing close (see app/lib/handoff.ts).
/// Listed in dashboard → Unanswered so the owner can add an answer to the
/// knowledge base ("qa" KnowledgeSource) or dismiss it.
model UnansweredQuestion {
  id            String       @id @default(cuid())
  apiKeyId      String
  apiKey        ApiKey       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  chatSessionId String?
  chatSession   ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  question      String       @db.Text
  reply         String?      @db.Text // what the agent said at the time
  reason        String // "model_unsure" | "low_score"
  topScore      Float?
  status        String       @default("open") // open | answered | dismissed
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())

  @@index([apiKeyId, status, createdAt])
}
